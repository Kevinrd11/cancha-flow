# Valores públicos: pueden estar disponibles en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_publishable

# Se usa únicamente en Route Handlers del servidor para comprobantes públicos.
# Nunca la prefijes con NEXT_PUBLIC_ ni la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_privada

# URL canónica de la aplicación (local o Vercel).
NEXT_PUBLIC_APP_URL=http://localhost:3000
