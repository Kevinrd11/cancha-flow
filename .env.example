# Valores públicos: pueden estar disponibles en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplaza_este_valor

# Se usa únicamente en el servidor para onboarding transaccional, rate limiting,
# auditoría y operaciones administrativas de Auth.
# Nunca la prefijes con NEXT_PUBLIC_ ni la expongas al cliente.
SUPABASE_SECRET_KEY=sb_secret_reemplaza_este_valor

# URL canónica exacta de la aplicación. Debe estar autorizada también en Supabase Auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto aleatorio de al menos 32 bytes usado para seudonimizar IP/correo en rate limiting.
# Genérelo fuera del repositorio; no reutilice JWT secrets ni claves de Supabase.
AUTH_RATE_LIMIT_PEPPER=genera_un_valor_aleatorio_largo

# Solo desarrollo local. Nunca se activa en NODE_ENV=production aunque valga true.
CANCHAFLOW_DEMO_MODE=false
